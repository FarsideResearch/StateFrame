{
  "schema": "stateframe-mutation-unit/1",
  "name": "file_facts",
  "revision": 1,
  "parent": null,
  "entry": "main.py",
  "summary": "Report bounded file size, lines, encoding, newlines, BOM, and binary facts.",
  "kind": "reader",
  "formats": ["bin", "txt"],
  "input_schema": {
    "type": "object",
    "properties": {"input_id": {"type": "string", "maxLength": 64}},
    "required": ["input_id"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "size_bytes": {"type": "integer"},
      "line_count": {"type": "integer"},
      "encoding": {"type": "string"},
      "newline": {"type": "string"},
      "bom": {"type": "string"},
      "binary": {"type": "boolean"}
    },
    "required": ["size_bytes", "line_count", "encoding", "newline", "bom", "binary"],
    "additionalProperties": false
  },
  "requires": {"network": false, "writes": false},
  "smoke": [{
    "input": {"input_id": "in0"},
    "inputs": ["fixtures/sample.txt"],
    "expect": {"size_bytes": 11, "line_count": 2, "encoding": "utf-8",
               "newline": "lf", "bom": "none", "binary": false}
  }],
  "limits": {"wall_s": 10, "cpu_s": 5, "mem_mb": 256}
}
