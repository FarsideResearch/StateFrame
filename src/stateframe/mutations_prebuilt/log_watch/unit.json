{
  "schema": "stateframe-mutation-unit/1",
  "name": "log_watch",
  "revision": 1,
  "parent": null,
  "entry": "main.py",
  "summary": "Count literal patterns in a bounded log tail and classify rotation or truncation.",
  "kind": "watcher",
  "input_schema": {
    "type": "object",
    "properties": {
      "input_id": {"type": "string", "maxLength": 64},
      "patterns": {"type": "array", "items": {"type": "string", "maxLength": 256}, "maxItems": 20},
      "previous": {"type": "object", "properties": {
        "identity": {"type": "string"}, "size": {"type": "integer"}, "start": {"type": "integer"}
      }, "additionalProperties": false},
      "current": {"type": "object", "properties": {
        "identity": {"type": "string"}, "size": {"type": "integer"}, "start": {"type": "integer"}
      }, "additionalProperties": false}
    },
    "required": ["input_id", "patterns"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "tail_bytes": {"type": "integer"}, "line_count": {"type": "integer"},
      "snapshot_change": {"type": "string", "enum": ["stable", "rotated", "truncated", "rotated_truncated"]},
      "counts": {"type": "array", "items": {"type": "object", "properties": {
        "pattern": {"type": "string"}, "count": {"type": "integer"}
      }, "required": ["pattern", "count"], "additionalProperties": false}, "maxItems": 20}
    },
    "required": ["tail_bytes", "line_count", "snapshot_change", "counts"],
    "additionalProperties": false
  },
  "requires": {"network": false, "writes": false},
  "smoke": [{
    "input": {"input_id": "in0", "patterns": ["ERROR", "WARN"]},
    "inputs": ["fixtures/sample.log"],
    "expect": {"snapshot_change": "stable",
               "counts": [{"pattern": "ERROR", "count": 1}, {"pattern": "WARN", "count": 1}]}
  }],
  "limits": {"wall_s": 10, "cpu_s": 5, "mem_mb": 256}
}
