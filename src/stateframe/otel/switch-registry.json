{
  "schema": "stateframe-otel-switches/1",
  "version": 1,
  "default_mode": "off",
  "modes": ["export", "status", "purge"],
  "switches": [
    {"name":"--stopped","cli":"export","env":null,"toml":null,"default":false,"values":[true,false],"sensitive":false,"support":"supported"},
    {"name":"--trust-source","cli":"export","env":null,"toml":null,"default":false,"values":[true,false],"sensitive":false,"support":"supported"},
    {"name":"--json","cli":"status","env":null,"toml":null,"default":false,"values":[true,false],"sensitive":false,"support":"supported"},
    {"name":"--yes","cli":"purge","env":null,"toml":null,"default":false,"values":[true,false],"sensitive":false,"support":"supported"},
    {"name":"--config","cli":"export,status","env":null,"toml":null,"default":null,"values":"owner-only absolute TOML path outside protected roots","sensitive":true,"support":"supported"},
    {"name":"OTEL_SDK_DISABLED","cli":null,"env":"OTEL_SDK_DISABLED","toml":null,"default":"false","values":["true","false","empty"],"sensitive":false,"support":"supported_veto"},
    {"name":"OTEL_TRACES_EXPORTER","cli":"--traces (export)","env":"OTEL_TRACES_EXPORTER","toml":"[traces].exporter","default":"otlp","values":["otlp","none"],"sensitive":false,"support":"supported"},
    {"name":"--protocol","cli":"export","env":"OTEL_EXPORTER_OTLP_TRACES_PROTOCOL","toml":"[otlp].protocol; [traces].protocol","default":"http/protobuf","values":["http/protobuf","http/json"],"sensitive":false,"support":"supported"},
    {"name":"--compression","cli":"export","env":"OTEL_EXPORTER_OTLP_TRACES_COMPRESSION","toml":"[otlp].compression; [traces].compression","default":"none","values":["none","gzip"],"sensitive":false,"support":"supported"},
    {"name":"--max-export-time-milliseconds","cli":"export; --timeout-ms alias","env":"OTEL_EXPORTER_OTLP_TRACES_TIMEOUT","toml":"max_export_time_milliseconds; timeout_ms alias","default":10000,"values":"integer 100..30000 ms","sensitive":false,"support":"supported"},
    {"name":"OTEL_EXPORTER_OTLP_ENDPOINT","cli":null,"env":"OTEL_EXPORTER_OTLP_ENDPOINT","toml":"[otlp].endpoint","default":"http://127.0.0.1:4318","values":"HTTP(S) endpoint without query, fragment or userinfo; plain HTTP loopback literals only","sensitive":true,"support":"supported"},
    {"name":"OTEL_EXPORTER_OTLP_TRACES_ENDPOINT","cli":null,"env":"OTEL_EXPORTER_OTLP_TRACES_ENDPOINT","toml":"[traces].endpoint","default":null,"values":"complete HTTP(S) trace URL without query, fragment or userinfo; plain HTTP loopback literals only","sensitive":true,"support":"supported"},
    {"name":"OTEL_EXPORTER_OTLP_HEADERS","cli":null,"env":"OTEL_EXPORTER_OTLP_HEADERS","toml":"[otlp].headers","default":"empty","values":"up to 32 encoded ASCII pairs; HTTPS only","sensitive":true,"support":"supported"},
    {"name":"OTEL_EXPORTER_OTLP_TRACES_HEADERS","cli":null,"env":"trace-specific headers","toml":"[traces].headers","default":"empty","values":"up to 32 encoded ASCII pairs; HTTPS only","sensitive":true,"support":"supported"},
    {"name":"OTEL_EXPORTER_OTLP_TRACES_CERTIFICATE","cli":null,"env":"generic or trace certificate","toml":"certificate","default":null,"values":"owner-only CA file; HTTPS only","sensitive":true,"support":"supported"},
    {"name":"OTEL_EXPORTER_OTLP_TRACES_CLIENT_CERTIFICATE","cli":null,"env":"generic or trace client certificate","toml":"client_certificate","default":null,"values":"owner-only certificate paired with key","sensitive":true,"support":"supported"},
    {"name":"OTEL_EXPORTER_OTLP_TRACES_CLIENT_KEY","cli":null,"env":"generic or trace client key","toml":"client_key","default":null,"values":"owner-only mode 0600 file paired with certificate","sensitive":true,"support":"supported"},
    {"name":"--trace-sampler","cli":"export; --sample alias","env":"OTEL_TRACES_SAMPLER","toml":"[sampling].sampler","default":"always_on","values":["always_on","always_off","traceidratio"],"sensitive":false,"support":"supported_subset"},
    {"name":"--trace-sampling-ratio","cli":"export; --sample-ratio alias","env":"OTEL_TRACES_SAMPLER_ARG","toml":"[sampling].ratio","default":"1","values":"ASCII decimal 0..1, at most 9 fractional digits","sensitive":false,"support":"supported"},
    {"name":"--include-cost","cli":"export,status","env":"OTEL_STATEFRAME_INCLUDE_COST","toml":"[detail].include_cost","default":false,"values":[true,false],"sensitive":false,"support":"supported"},
    {"name":"[detail].price_per_million_input_tokens","cli":null,"env":null,"toml":"[detail].price_per_million_input_tokens","default":null,"values":"finite nonnegative number up to 1000000000000; rates must be paired","sensitive":false,"support":"supported"},
    {"name":"[detail].price_per_million_output_tokens","cli":null,"env":null,"toml":"[detail].price_per_million_output_tokens","default":null,"values":"finite nonnegative number up to 1000000000000; rates must be paired","sensitive":false,"support":"supported"},
    {"name":"OTEL_TRACES_SAMPLER_PARENTBASED_*","cli":null,"env":"OTEL_TRACES_SAMPLER","toml":"[sampling].sampler","default":null,"values":"parent-based samplers","sensitive":false,"support":"unsupported_fixed_diagnostic"},
    {"name":"OTEL_EXPORTER_OTLP_LOGS_*","cli":null,"env":"logs exporter environment family","toml":null,"default":"disabled","values":"logs export","sensitive":true,"support":"unsupported_fixed_diagnostic"},
    {"name":"OTEL_LOGS_EXPORTER","cli":null,"env":"OTEL_LOGS_EXPORTER","toml":null,"default":"none","values":"logs exporter selectors","sensitive":false,"support":"unsupported_fixed_diagnostic"},
    {"name":"OTEL_SERVICE_NAME","cli":null,"env":"OTEL_SERVICE_NAME","toml":null,"default":"stateframe","values":["stateframe"],"sensitive":false,"support":"accepted_noop"},
    {"name":"OTEL_PROPAGATORS","cli":null,"env":"OTEL_PROPAGATORS","toml":null,"default":"none","values":["none"],"sensitive":false,"support":"accepted_noop"},
    {"name":"TRACEPARENT, OTEL_BAGGAGE, OTEL_TRACESTATE","cli":null,"env":"context propagation environment","toml":null,"default":"ignored","values":"all external context propagation","sensitive":true,"support":"unsupported_fixed_diagnostic"},
    {"name":"OTEL_ATTRIBUTE_* and OTEL_SPAN_*_COUNT_LIMIT","cli":null,"env":"attribute/span limit environment family","toml":null,"default":"hard local caps","values":"SDK limit overrides","sensitive":false,"support":"unsupported_fixed_diagnostic"},
    {"name":"OTEL_BSP_* and OTEL_BLRP_*","cli":null,"env":"SDK processor/queue environment family","toml":null,"default":"fixed local bounds","values":"SDK processor and queue overrides","sensitive":false,"support":"unsupported_fixed_diagnostic"},
    {"name":"OTEL_RESOURCE_ATTRIBUTES and OTEL_RESOURCE_DETECTORS","cli":null,"env":"resource environment family","toml":null,"default":"fixed resources","values":"custom or automatic resources","sensitive":true,"support":"unsupported_fixed_diagnostic"},
    {"name":"HTTP_PROXY, HTTPS_PROXY, ALL_PROXY, NO_PROXY","cli":null,"env":"proxy environment","toml":null,"default":"direct connection","values":"proxy routing","sensitive":true,"support":"unsupported_ignored"}
  ],
  "qualifications": [],
  "unqualified_routes": [
    {"route":"generic local OTLP HTTP receiver","signals":["traces"],"protocols":["http/protobuf","http/json"],"qualified":false},
    {"route":"operator-selected direct OTLP HTTP receiver","signals":["traces"],"protocols":["http/protobuf","http/json"],"qualified":false},
    {"route":"operator-selected Collector relay","signals":["traces"],"protocols":["http/protobuf","http/json"],"qualified":false}
  ]
}
