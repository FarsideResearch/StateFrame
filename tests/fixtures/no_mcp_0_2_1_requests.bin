    "name": "read",
    "description": "Read source from a path and optional range. max_chars defaults to 12000 (maximum 64000) and can clip the page; the result reports the effective delivered span and a revision-bound next cursor when more source remains. The source body has no line-number gutter. Use where_defined or references to locate a symbol instead of paging by guesswork.",
    "parameters": {
     "type": "object",
     "properties": {
      "path": {
       "type": "string",
       "description": "workspace-relative file or directory path"
      },
      "cursor": {
       "type": "string",
       "description": "Revision-bound continuation from a prior source page; resumes at its exact line and column. Use with max_lines/max_chars only."
      },
      "line": {
       "type": "integer",
       "minimum": 1,
       "description": "1-based start_line alias; default 1. Use with end_line for an inclusive range."
